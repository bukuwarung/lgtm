{
  "name": "lgtm",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "test": "node --test test/*.test.ts",
    "firefox": "web-ext run -s dist",
    "chrome": "web-ext run -s dist -t chromium",
    "package": "web-ext build -s dist -a artifacts --overwrite-dest"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.3.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "web-ext": "^10.8.0"
  }
}
