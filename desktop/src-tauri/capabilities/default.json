{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core APIs, lgtm's own commands, and the plugins it needs (links, notifications, lgtm:// links, launch at login). No shell or file access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-gh-token",
    "allow-notify",
    "allow-gh-accounts",
    "allow-slack-emoji",
    "allow-jira-move",
    "allow-integrations",
    "allow-jira-issue",
    "allow-job-log",
    "allow-slack-status",
    "allow-slack-notify",
    "allow-slack-people-get",
    "allow-slack-people-find",
    "allow-slack-people-save",
    "allow-export-settings",
    "allow-claude-sessions",
    "allow-clipboard-pr",
    "allow-copy-text",
    "allow-self-update",
    "allow-claude-text",
    "allow-claude-skill",
    "allow-claude-outbox",
    "allow-claude-session",
    "core:window:allow-set-badge-count",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "claude://*"
        }
      ]
    },
    "notification:default",
    "deep-link:default",
    "autostart:default"
  ]
}
