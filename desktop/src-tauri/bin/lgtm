#!/bin/sh
# lgtm [PR link]: opens the lgtm app, at that pull request if given. Installed by the Homebrew cask, which links it
# from the app bundle. A link may carry ?claude=<session> (the lgtm-review skill), passed on to the app.
case "$1" in
  "") exec open -b com.bukuwarung.lgtm ;;
  https://github.com/*/pull/*) exec open "lgtm://${1#https://github.com/}" ;;
  lgtm://*) exec open "$1" ;;
  -h | --help)
    echo "usage: lgtm [https://github.com/OWNER/REPO/pull/NUMBER]"
    echo "Opens the lgtm app, at that pull request if given."
    ;;
  *)
    echo "lgtm: not a pull request link: $1" >&2
    echo "usage: lgtm [https://github.com/OWNER/REPO/pull/NUMBER]" >&2
    exit 64
    ;;
esac
